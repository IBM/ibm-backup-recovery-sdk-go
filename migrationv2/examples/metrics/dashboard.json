          "expr": "histogram_quantile(0.95, sum(rate(ibm_brs_operation_duration_seconds_bucket[5m])) by (le, operation))",
          "legendFormat": "{{operation}} (p95)",
          "refId": "A"
        }
      ],
      "title": "Operation Duration (p95)",
      "type": "timeseries"
