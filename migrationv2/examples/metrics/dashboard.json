        {
          "expr": "sum(ibm_brs_operation_total{status=\"failure\"})",
          "refId": "A"
        }
      ],
      "title": "Total Failures",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
